{
  "type": "extension",
  "name": "jev_vad_python",
  "version": "0.11.73",
  "display_name": {
    "locales": {
      "en-US": {
        "content": "JEV VAD Python Extension"
      }
    }
  },
  "description": {
    "locales": {
      "en-US": {
        "content": "Extension controlling the voice activity and sending commands for interruptions by agent."
      }
    }
  },
  "readme": {
    "locales": {
      "en-US": {
        "import_uri": "docs/README.en-US.md"
      }
    }
  },
  "tags": [
    "python",
    "voice_activity_detection",
    "agent_interruption",
    "backchannels"
  ],
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11.73"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "pyproject.toml",
      "tests/**.py",
      "tests/pyproject.toml",
      "tests/bin/*",
      "requirements.txt",
      "docs/**",
      ".vscode/**"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string"
            },
            "end_of_turn_threshold": {
              "type": "float32"
            },
            "backchannel_detection_threshold": {
              "type": "float32"
            },
            "interruption_threshold": {
              "type": "float32"
            },
            "backchannel_reproduction_threshold": {
              "type": "float32"
            }
          }
        }
      }
    },
    "data_in": [
      {
        "name": "asr_result",
        "property": {
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "final": {
              "type": "bool"
            },
            "start_ms": {
              "type": "int64"
            },
            "duration_ms": {
              "type": "int64"
            },
            "language": {
              "type": "string"
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "word": {
                    "type": "string"
                  },
                  "start_ms": {
                    "type": "int64"
                  },
                  "duration_ms": {
                    "type": "int64"
                  },
                  "stable": {
                    "type": "bool"
                  }
                }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string"
                },
                "asr_info": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        },
        "required": [
          "id",
          "text",
          "final",
          "start_ms",
          "duration_ms",
          "language"
        ]
      },
      {
        "name": "asr_finalize_end",
        "property": {
          "properties": {
            "finalize_id": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    ],
    "data_out": [
      {
        "name": "end_of_turn",
        "property": {
          "properties": {
            "end_of_turn": {
              "type": "bool"
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "test": "tests/bin/start"
  }
}