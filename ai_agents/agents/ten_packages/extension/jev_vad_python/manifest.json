{
  "type": "extension",
  "name": "jev_vad_python",
  "version": "0.11.73",
  "display_name": {
    "locales": {
      "en-US": {
        "content": "JEV VAD Python Extension"
      }
    }
  },
  "description": {
    "locales": {
      "en-US": {
        "content": "Extension controlling the voice activity and sending commands for interruptions by agent."
      }
    }
  },
  "readme": {
    "locales": {
      "en-US": {
        "import_uri": "docs/README.en-US.md"
      }
    }
  },
  "tags": [
    "python",
    "voice_activity_detection",
    "agent_interruption",
    "backchannels"
  ],
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11.73"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "pyproject.toml",
      "tests/**.py",
      "tests/pyproject.toml",
      "tests/bin/*",
      "requirements.txt",
      "docs/**",
      "assets/**",
      ".vscode/**"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "api_key": {
          "type": "string"
        },
        "end_of_turn_threshold": {
          "type": "float32"
        },
        "backchannel_detection_threshold": {
          "type": "float32"
        },
        "interruption_detection_threshold": {
          "type": "float32"
        },
        "interruption_reproduction_threshold": {
          "type": "float32"
        },
        "backchannel_reproduction_threshold": {
          "type": "float32"
        },
        "fallback_end_of_turn_ms": {
          "type": "int64"
        },
        "backchannel_cooldown_ms": {
          "type": "int64"
        },
        "backchannel_max_silence_ms": {
          "type": "int64"
        },
        "agent_interrupt_cooldown_ms": {
          "type": "int64"
        },
        "min_words_for_agent_interrupt": {
          "type": "int64"
        },
        "backchannel_asset_dir": {
          "type": "string"
        },
        "backchannel_sample_rate": {
          "type": "int64"
        },
        "audio_dest_frame_ms": {
          "type": "int64"
        },
        "jev_timeout_ms": {
          "type": "int64"
        }
      }
    },
    "data_in": [
      {
        "name": "asr_result"
      },
      {
        "name": "asr_finalize_end"
      },
      {
        "name": "agent_text"
      },
      {
        "name": "tts_audio_start"
      },
      {
        "name": "tts_audio_end"
      }
    ],
    "cmd_in": [
      {
        "name": "start_of_sentence"
      },
      {
        "name": "end_of_sentence"
      }
    ],
    "data_out": [
      {
        "name": "end_of_turn",
        "property": {
          "properties": {
            "text": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "confidence": {
              "type": "float32"
            }
          }
        }
      },
      {
        "name": "agent_interrupt",
        "property": {
          "properties": {
            "text": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "confidence": {
              "type": "float32"
            }
          }
        }
      }
    ],
    "cmd_out": [
      {
        "name": "interrupt"
      }
    ],
    "audio_frame_out": [
      {
        "name": "pcm_frame",
        "property": {
          "properties": {
            "channel": {
              "type": "string"
            },
            "stream_id": {
              "type": "uint32"
            },
            "source": {
              "type": "string"
            },
            "remote_user_id": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string"
                }
              },
              "required": [
                "session_id"
              ]
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "test": "tests/bin/start"
  }
}